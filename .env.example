# Copie este archivo como .env (nunca suba el .env real).
# Clave de la API de Claude (console.anthropic.com). Sin ella la app usa reglas por palabras clave.
ANTHROPIC_API_KEY=
# Modelo de Claude (por defecto claude-opus-5-5; claude-haiku-5-5 baja el costo por visita).
CLAUDE_MODEL=claude-opus-5-5
# Tamaño de Whisper: base (rápido), small (por defecto), large-v3-turbo (más preciso, más lento).
WHISPER_MODEL=small
# 1 = carga Whisper al arrancar para que la primera grabación no espere.
WHISPER_PRELOAD=1
